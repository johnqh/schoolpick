{
  "name": "schoolpick",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:cf-env": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-cloudflare-env.ts -o /tmp/generate-cloudflare-env.ts && bunx tsx /tmp/generate-cloudflare-env.ts",
    "dev": "convex dev --start 'vite --open'",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "lint": "npm run typecheck && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy": "npx @convex-dev/static-hosting deploy",
    "process:static": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/process-static-files.ts -o /tmp/process-static-files.ts && bunx tsx /tmp/process-static-files.ts",
    "seo:fetch": "curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-seo-assets-v2.mjs -o /tmp/generate-seo-assets.mjs",
    "generate:sitemap": "bun run seo:fetch && node /tmp/generate-seo-assets.mjs public",
    "prerender": "node scripts/prerender.mjs",
    "prerender:install": "bunx playwright install --with-deps chromium",
    "generate": "bun run process:static && bun run generate:sitemap && bun run prerender:install && bun run prerender"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "~0.2.1",
    "@radix-ui/react-dialog": "~1.3.1",
    "@radix-ui/react-dropdown-menu": "~2.1.24",
    "@radix-ui/react-icons": "~1.3.2",
    "@radix-ui/react-slot": "~1.5.0",
    "@radix-ui/react-toggle": "~1.1.18",
    "@radix-ui/react-toggle-group": "~1.1.19",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "convex": "~1.45.0",
    "i18next": "~23.16.8",
    "next-themes": "~0.4.6",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "react-i18next": "~15.7.4",
    "react-router-dom": "~7.18.4",
    "tailwind-merge": "~2.6.1",
    "tailwindcss-animate": "~1.0.7",
    "@sudobility/seo_lib": "^0.0.39"
  },
  "devDependencies": {
    "@types/node": "~20.19.43",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "@typescript-eslint/eslint-plugin": "~7.18.0",
    "@typescript-eslint/parser": "~7.18.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "~4.7.0",
    "autoprefixer": "~10.6.1",
    "eslint": "~8.57.1",
    "eslint-plugin-react-hooks": "~4.6.2",
    "eslint-plugin-react-refresh": "~0.4.26",
    "postcss": "~8.5.31",
    "prettier": "~3.9.10",
    "tailwindcss": "~3.4.19",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "~5.4.21",
    "playwright": "~1.64.1",
    "tsx": "~4.23.15"
  }
}
