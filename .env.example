# ============================================================================
# SchoolPick environment configuration
# ============================================================================
# `npx convex dev` writes its own values into .env.local, which is gitignored
# via the `*.local` rule. Only VITE_*-prefixed variables reach the browser.
# ============================================================================

# ============================================================================
# CONVEX CONFIGURATION
# ============================================================================

# Convex deployment URL the React client connects to (src/main.tsx).
# Printed by `npx convex dev`, e.g. https://your-deployment.convex.cloud
VITE_CONVEX_URL=
